# Go build and test output
/things3
/cmd/things3/things3
*.test
*.out
coverage.*
*.prof

# GoReleaser output
/dist/

# Go workspace: local development only, recreated by CI
go.work
go.work.sum

# SQLite working files. Things keeps -wal/-shm sidecars beside the database and
# tests copy fixtures around; the testdata fixtures are re-admitted below.
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local environment and editor state
.env
.idea/
.DS_Store

# ==============================================================================
# Whitelist
#
# A global gitignore may be allow-list style, blocking everything with a bare
# "*". Every file type this repository tracks therefore needs an entry here, or
# it is silently untracked on such a setup. Add one when introducing a new kind
# of tracked file.
# ==============================================================================
!*.go
!*.md
!go.mod
!go.sum
!LICENSE
!.gitignore
!.golangci.yml
!.codecov.yml
!.goreleaser.yml
!.github/**/*.yml
!**/testdata/**/*.json
!testdata/**/*.sqlite
